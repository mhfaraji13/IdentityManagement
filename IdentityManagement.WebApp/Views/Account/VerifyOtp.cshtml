@model IdentityManagement.WebApp.ViewModels.VerifyOtpViewModel

@{
    ViewData["Title"] = "Verify OTP";
}

<div class="container mt-5">
    <div class="row justify-content-center">
        <div class="col-md-5">

            <div class="card shadow">
                <div class="card-body p-4">

                    <h3 class="text-center mb-4">
                        Verify OTP
                    </h3>

                    <p class="text-muted text-center">
                        Enter the 6-digit code to continue.
                    </p>

                    @if (TempData["DevelopmentOtp"] != null)
                    {
                        <div class="alert alert-info text-center">
                            <strong>Development OTP:</strong>
                            @TempData["DevelopmentOtp"]
                        </div>
                    }

                    <form asp-controller="Account"
                          asp-action="VerifyOtp"
                          method="post">

                        <input type="hidden" asp-for="UserId" />

                        <div asp-validation-summary="ModelOnly"
                             class="text-danger mb-3">
                        </div>

                        <div class="mb-3">
                            <label asp-for="Otp" class="form-label">
                                OTP Code
                            </label>

                            <input asp-for="Otp"
                                   class="form-control text-center"
                                   type="text"
                                   inputmode="numeric"
                                   maxlength="6"
                                   placeholder="Enter 6-digit code"
                                   autocomplete="one-time-code" />

                            <span asp-validation-for="Otp"
                                  class="text-danger">
                            </span>
                        </div>

                        <button type="submit"
                                class="btn btn-primary w-100">
                            Verify Code
                        </button>

                    </form>

                </div>
            </div>

        </div>
    </div>
</div>
