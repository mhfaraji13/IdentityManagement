@model IdentityManagement.WebApp.ViewModels.EditUserViewModel

@{
    ViewData["Title"] = "Edit User";
}

<div class="row justify-content-center">

    <div class="col-lg-8 col-md-10">

        <div class="card">

            <div class="card-header bg-white py-3">
                <h4 class="card-title mb-0">
                    Edit User
                </h4>
            </div>

            <div class="card-body">

                <form asp-controller="Users"
                      asp-action="Edit"
                      asp-route-id="@Model.Id"
                      method="post">

                    <input type="hidden" asp-for="Id" />

                    <div asp-validation-summary="ModelOnly"
                         class="text-danger mb-3">
                    </div>

                    <div class="row">

                        <div class="col-md-6 mb-4">

                            <label asp-for="UserName"
                                   class="form-label">
                                Username
                            </label>

                            <input asp-for="UserName"
                                   class="form-control"
                                   placeholder="Enter username" />

                            <span asp-validation-for="UserName"
                                  class="text-danger">
                            </span>

                        </div>

                        <div class="col-md-6 mb-4">

                            <label asp-for="DisplayName"
                                   class="form-label">
                                Display Name
                            </label>

                            <input asp-for="DisplayName"
                                   class="form-control"
                                   placeholder="Enter display name" />

                        </div>

                        <div class="col-md-6 mb-4">

                            <label asp-for="Email"
                                   class="form-label">
                                Email
                            </label>

                            <input asp-for="Email"
                                   class="form-control"
                                   placeholder="Enter email address" />

                            <span asp-validation-for="Email"
                                  class="text-danger">
                            </span>

                        </div>

                        <div class="col-md-6 mb-4">

                            <label asp-for="PhoneNumber"
                                   class="form-label">
                                Phone Number
                            </label>

                            <div class="input-group">

                                <span class="input-group-text">
                                    +98
                                </span>

                                <input asp-for="PhoneNumber"
                                       class="form-control"
                                       type="text"
                                       inputmode="numeric"
                                       maxlength="10"
                                       minlength="10"
                                       pattern="[0-9]{10}"
                                       placeholder="9121234567" />

                            </div>

                            <span asp-validation-for="PhoneNumber"
                                  class="text-danger">
                            </span>

                        </div>

                    </div>

                    <hr />

                    <div class="form-check form-switch mb-4">

                        <input asp-for="IsActive"
                               class="form-check-input"
                               type="checkbox" />

                        <label asp-for="IsActive"
                               class="form-check-label">
                            Active
                        </label>

                    </div>

                    <div class="d-flex gap-2">

                        <button type="submit"
                                class="btn btn-primary">
                            <i class="ti ti-device-floppy me-1"></i>
                            Save Changes
                        </button>

                        <a asp-controller="Users"
                           asp-action="Index"
                           class="btn btn-light">
                            Cancel
                        </a>

                    </div>

                </form>

            </div>
        </div>

    </div>

</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
