@model IdentityManagement.WebApp.ViewModels.ManageUserRolesViewModel

@{
    ViewData["Title"] = "Manage User Roles";
}

<div class="container mt-5">

    <div class="card shadow">
        <div class="card-header">
            <h4>Manage User Roles</h4>
        </div>

        <div class="card-body">

            <h5 class="mb-4">
                User: @Model.UserName
            </h5>

            <form asp-controller="Users"
                  asp-action="ManageRoles"
                  method="post">

                <input type="hidden" asp-for="UserId" />
                <input type="hidden" asp-for="UserName" />

                @if (Model.Roles.Any())
                {
                    @for (int i = 0; i < Model.Roles.Count; i++)
                    {
                        <div class="form-check mb-3">

                            <input type="hidden"
                                   asp-for="Roles[i].RoleId" />

                            <input class="form-check-input"
                                   type="checkbox"
                                   asp-for="Roles[i].IsSelected" />

                            <label class="form-check-label"
                                   asp-for="Roles[i].IsSelected">
                                @Model.Roles[i].RoleName
                            </label>

                        </div>
                    }
                }
                else
                {
                    <p>No roles are available.</p>
                }

                <button type="submit" class="btn btn-primary">
                    Save Changes
                </button>

                <a asp-controller="Users"
                   asp-action="Index"
                   class="btn btn-secondary">
                    Cancel
                </a>

            </form>

        </div>
    </div>

</div>
