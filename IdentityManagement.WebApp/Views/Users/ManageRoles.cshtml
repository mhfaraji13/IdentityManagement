@model IdentityManagement.WebApp.ViewModels.ManageUserRolesViewModel

@{
    ViewData["Title"] = "Manage User Roles";
}

<div class="row justify-content-center">

    <div class="col-lg-7 col-md-9">

        <div class="card">

            <div class="card-header bg-white py-3">
                <h4 class="card-title mb-0">
                    Manage User Roles
                </h4>
            </div>

            <div class="card-body">

                <div class="alert alert-light border mb-4">
                    <strong>User:</strong>
                    @Model.UserName
                </div>

                <form asp-controller="Users"
                      asp-action="ManageRoles"
                      method="post">

                    <input type="hidden" asp-for="UserId" />
                    <input type="hidden" asp-for="UserName" />

                    <h5 class="mb-3">Available Roles</h5>

                    @if (Model.Roles.Any())
                    {
                        @for (int i = 0; i < Model.Roles.Count; i++)
                        {
                            <div class="d-flex justify-content-between align-items-center border rounded p-3 mb-3">

                                <div>
                                    <strong>
                                        @Model.Roles[i].RoleName
                                    </strong>
                                </div>

                                <div class="form-check form-switch mb-0">

                                    <input type="hidden"
                                           asp-for="Roles[i].RoleId" />

                                    <input class="form-check-input"
                                           type="checkbox"
                                           asp-for="Roles[i].IsSelected" />

                                    <label class="form-check-label"
                                           asp-for="Roles[i].IsSelected">
                                        Assigned
                                    </label>

                                </div>

                            </div>
                        }
                    }
                    else
                    {
                        <div class="alert alert-warning">
                            No roles are available.
                        </div>
                    }

                    <hr />

                    <div class="d-flex gap-2">

                        <button type="submit"
                                class="btn btn-primary">
                            <i class="ti ti-device-floppy me-1"></i>
                            Save Changes
                        </button>

                        <a asp-controller="Users"
                           asp-action="Index"
                           class="btn btn-light">
                            Cancel
                        </a>

                    </div>

                </form>

            </div>
        </div>

    </div>

</div>
