@model IdentityManagement.WebApp.ViewModels.CreateUserViewModel

@{
    ViewData["Title"] = "Create User";
}

<div class="row justify-content-center">

    <div class="col-lg-8 col-md-10">

        <div class="card">

            <div class="card-header bg-white py-3">
                <h4 class="card-title mb-0">
                    Create New User
                </h4>
            </div>

            <div class="card-body">

                <form asp-controller="Users"
                      asp-action="Create"
                      method="post">

                    <div asp-validation-summary="ModelOnly"
                         class="alert alert-danger">
                    </div>

                    <div class="row">

                        <div class="col-md-6 mb-4">

                            <label asp-for="UserName"
                                   class="form-label">
                                Username
                            </label>

                            <input asp-for="UserName"
                                   class="form-control"
                                   placeholder="Enter username" />

                            <span asp-validation-for="UserName"
                                  class="text-danger">
                            </span>

                        </div>

                        <div class="col-md-6 mb-4">

                            <label asp-for="Password"
                                   class="form-label">
                                Password
                            </label>

                            <input asp-for="Password"
                                   class="form-control"
                                   type="password"
                                   placeholder="Enter password"
                                   autocomplete="new-password" />

                            <span asp-validation-for="Password"
                                  class="text-danger">
                            </span>

                        </div>

                        <div class="col-md-6 mb-4">

                            <label asp-for="DisplayName"
                                   class="form-label">
                                Display Name
                            </label>

                            <input asp-for="DisplayName"
                                   class="form-control"
                                   placeholder="Enter display name" />

                        </div>

                        <div class="col-md-6 mb-4">

                            <label asp-for="Email"
                                   class="form-label">
                                Email
                            </label>

                            <input asp-for="Email"
                                   class="form-control"
                                   placeholder="Enter email address" />

                            <span asp-validation-for="Email"
                                  class="text-danger">
                            </span>

                        </div>

                        <div class="col-md-6 mb-4">

                            <label asp-for="PhoneNumber"
                                   class="form-label">
                                Phone Number
                            </label>

                            <div class="input-group">
                                <span class="input-group-text">
                                    +98
                                </span>

                                <input asp-for="PhoneNumber"
                                       class="form-control"
                                       type="text"
                                       inputmode="numeric"
                                       maxlength="10"
                                       minlength="10"
                                       pattern="[0-9]{10}"
                                       placeholder="9121234567" />
                            </div>

                            <span asp-validation-for="PhoneNumber"
                                  class="text-danger">
                            </span>

                        </div>

                    </div>

                    <hr />

                    <div class="d-flex gap-2">

                        <button type="submit"
                                class="btn btn-primary">
                            <i class="ti ti-user-plus me-1"></i>
                            Create User
                        </button>

                        <a asp-controller="Users"
                           asp-action="Index"
                           class="btn btn-light">
                            Cancel
                        </a>

                    </div>

                </form>

            </div>
        </div>

    </div>

</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
