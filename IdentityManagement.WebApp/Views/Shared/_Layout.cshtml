<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Identity Management</title>

    <link rel="shortcut icon" type="image/png"
          href="~/assets/images/logos/favicon.png" />

    <link rel="stylesheet" href="~/assets/css/styles.min.css" />
    <link rel="stylesheet" href="~/css/site.css" />

    @await RenderSectionAsync("Styles", required: false)
</head>

<body>
    <div id="main-wrapper">

        <header class="app-header">
            <nav class="navbar navbar-expand-lg container-fluid">

                <!-- Logo -->
                <a class="navbar-brand d-flex align-items-center"
                   asp-controller="Dashboard"
                   asp-action="Index">
                    <img src="~/assets/images/logos/logo.svg"
                         alt="Identity Management"
                         width="150" />
                </a>

                <!-- Navigation -->
                <div class="navbar-collapse show">
                    <ul class="navbar-nav mx-auto flex-row align-items-center gap-3">

                        @if (User.Identity?.IsAuthenticated == true)
                        {
                            <li class="nav-item">
                                <a class="nav-link"
                                   asp-controller="Dashboard"
                                   asp-action="Index">
                                    <i class="ti ti-dashboard me-1"></i>
                                    Dashboard
                                </a>
                            </li>

                            @if (User.IsInRole("Admin"))
                            {
                                <li class="nav-item">
                                    <a class="nav-link"
                                       asp-controller="Users"
                                       asp-action="Index">
                                        <i class="ti ti-users me-1"></i>
                                        Users
                                    </a>
                                </li>
                            }
                        }
                        @if (User.Identity?.IsAuthenticated == true)
                        {
                            <li class="nav-item">
                                <span class="nav-link text-danger">
                                    Admin Check: @User.IsInRole("Admin")
                                </span>
                            </li>

                            <li class="nav-item">
                                <span class="nav-link text-danger">
                                    Roles:
                                    @string.Join(", ",
                                        User.Claims
                                            .Where(c => c.Type ==
                                                "http://schemas.microsoft.com/ws/2008/06/identity/claims/role")
                                            .Select(c => c.Value))
                                </span>
                            </li>
                        }

                    </ul>
                </div>

                <!-- Profile: authenticated users only -->
                @if (User.Identity?.IsAuthenticated == true)
                {
                    <div class="dropdown">
                        <a class="nav-link p-0"
                           href="#"
                           id="profileDropdown"
                           data-bs-toggle="dropdown"
                           aria-expanded="false">

                            <img src="~/assets/images/profile/user-1.jpg"
                                 alt="Profile"
                                 width="40"
                                 height="40"
                                 class="rounded-circle" />
                        </a>

                        <div class="dropdown-menu dropdown-menu-end dropdown-menu-animate-up"
                             aria-labelledby="profileDropdown">

                            <div class="message-body">

                                <a class="dropdown-item d-flex align-items-center gap-2"
                                   asp-controller="Profile"
                                   asp-action="Index">
                                    <i class="ti ti-user"></i>
                                    View My Profile
                                </a>

                                <a class="dropdown-item d-flex align-items-center gap-2"
                                   asp-controller="Profile"
                                   asp-action="Edit">
                                    <i class="ti ti-user-edit"></i>
                                    Edit Profile
                                </a>

                                <form asp-controller="Account"
                                      asp-action="Logout"
                                      method="post">
                                    <button type="submit"
                                            class="dropdown-item d-flex align-items-center gap-2">
                                        <i class="ti ti-logout"></i>
                                        Logout
                                    </button>
                                </form>

                            </div>
                        </div>
                    </div>
                }

            </nav>
        </header>

        <main class="body-wrapper">
            <div class="body-wrapper-inner">
                <div class="container-fluid">
                    @RenderBody()
                </div>
            </div>
        </main>

    </div>

    <script src="~/assets/libs/jquery/dist/jquery.min.js"></script>
    <script src="~/assets/libs/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/assets/libs/simplebar/dist/simplebar.min.js"></script>
    <script src="~/assets/js/sidebarmenu.js"></script>
    <script src="~/assets/js/app.min.js"></script>

    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>