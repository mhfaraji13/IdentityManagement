@{
    ViewData["Title"] = "Dashboard";
}

<div class="row">

    <div class="col-lg-12">

        <div class="card">

            <div class="card-body">

                <h4 class="card-title">
                    Dashboard
                </h4>

                <p class="text-muted">
                    Welcome to Identity Management.
                </p>

                <div class="alert alert-success mt-4">
                    You have successfully logged in.
                </div>

                <div class="mt-4">
                    <h5>
                        Welcome, @User.Identity?.Name!
                    </h5>

                    <p class="text-muted">
                        You are now inside the Identity Management panel.
                    </p>
                </div>

                <hr />

                <form asp-controller="Account"
                      asp-action="Logout"
                      method="post">

                    <button type="submit"
                            class="btn btn-danger">
                        Logout
                    </button>

                </form>

            </div>

        </div>

    </div>

</div>
